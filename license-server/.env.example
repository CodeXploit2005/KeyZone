KEYZONE_ADMIN_PASSWORD=replace-with-a-long-random-private-password
KEYZONE_PUBLIC_URL=http://127.0.0.1:4320
KEYZONE_LICENSE_DB=./data/licenses.sqlite
# Render Free: use a Turso Free database instead of a local SQLite file.
# Both values are required on Render. Keep the token out of GitHub.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
PORT=4320
HOST=127.0.0.1
